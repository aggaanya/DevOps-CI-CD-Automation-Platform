# Local development environment for the CI/CD platform (docker compose).
# Copy this file to `.env` and adjust values for your machine.
# `.env` is gitignored — NEVER commit it.
# These are LOCAL development values only. Never reuse them in any shared or
# cloud environment.

# --- Frontend ---
FRONTEND_PORT=3000

# --- Backend (Control Plane) ---
BACKEND_PORT=8081

# --- RabbitMQ ---
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- PostgreSQL ---
POSTGRES_USER=cicd
POSTGRES_PASSWORD=cicd
POSTGRES_DB=cicd
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Keycloak (development mode) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8083

# --- Worker ---
WORKER_PORT=8082
WORKER_ID=worker-docker
